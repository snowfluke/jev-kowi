# Copy to .env and fill in. Bun loads .env automatically.
DISCORD_TOKEN_JEV=
OPENROUTER_API_KEY=

# Optional tuning (defaults shown):
# JEV_MODEL=~typesafe/jev-latest
# JEV_VOCAB_MODE=auto   # auto | en | id | mixed
# JEV_MAX_WORDS=30
# JEV_MIN_WORDS=2
# JEV_MAX_HISTORY=3
# JEV_STOP_THRESHOLD=0.5

# Optional LLM enhancement: Jev drafts, the chat model rewrites short.
# enhance = draft -> LLM rewrite (raw draft on failure); off = raw draft.
# The model is OpenRouter's free router (auto-picks a live free model).
# Set JEV_LLM_MODEL only to pin a specific model instead.
# JEV_LLM_MODE=enhance
# JEV_LLM_MODEL=openrouter/free
# JEV_LLM_MAX_WORDS=20

# Optional ambient listening: Jev may reply unprompted in this channel.
# Looks back over JEV_AMBIENT_FETCH messages, Jev picks the relevant
# ones, tiered gate decides (reply at THRESHOLD, second opinion down
# to TIE_LOW, skip below). Empty channel ID = disabled.
# JEV_AMBIENT_CHANNEL_ID=123456789012345678
# JEV_AMBIENT_FETCH=50
# JEV_AMBIENT_THRESHOLD=0.6
# JEV_AMBIENT_TIE_LOW=0.35
# JEV_AMBIENT_TIEBREAK=0.5
