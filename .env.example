# Copy to .env and fill in. Bun loads .env automatically.
DISCORD_TOKEN_JEV=
OPENROUTER_API_KEY=

# Optional tuning (defaults shown):
# JEV_MODEL=~typesafe/jev-latest
# JEV_VOCAB_MODE=auto   # auto | en | id | mixed
# JEV_MAX_WORDS=30
# JEV_MIN_WORDS=2
# JEV_MAX_HISTORY=3
# JEV_STOP_THRESHOLD=0.5

# Optional LLM enhancement: Jev drafts, the chat model rewrites short.
# enhance = draft -> LLM rewrite (raw draft on failure); off = raw draft.
# Models are tried in order; keep openrouter/free last as the catch-all.
# JEV_LLM_MODE=enhance
# JEV_LLM_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
# JEV_LLM_MAX_WORDS=20

# Optional ambient listening: Jev may reply unprompted in this channel
# when the latest message seems addressed to it. Empty = disabled.
# JEV_AMBIENT_CHANNEL_ID=123456789012345678
# JEV_AMBIENT_FETCH=10
# JEV_AMBIENT_THRESHOLD=0.5
